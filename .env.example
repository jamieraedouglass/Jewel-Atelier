# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Claude API key from console.anthropic.com (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for stone analysis and the design chat
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max AI calls (stone analyses + chat messages) per person per day
AI_DAILY_LIMIT=40

# Used to build share links and magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
