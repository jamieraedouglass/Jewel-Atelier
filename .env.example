# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase project settings → API → service_role key. Server only: used to create name-based accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Any long random string (e.g. run: openssl rand -hex 32). Never change it once people have accounts.
NAME_LOGIN_SECRET=change-me-to-a-long-random-string
# Optional shared word for your team. Leave empty to allow sign-in with just a name.
STUDIO_CODE=
# Set to true when STUDIO_CODE is set, so the sign-in page asks for it
NEXT_PUBLIC_STUDIO_CODE_REQUIRED=false

# Anthropic API key from console.anthropic.com (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for stone analysis and the design chat
ANTHROPIC_MODEL=claude-sonnet-5-5

# Max AI calls (stone analyses + chat messages) per person per day
AI_DAILY_LIMIT=40

# Used to build share links and magic-link redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which studio this deployment is: atelier (default) or kothari (Kotharis branding, private site)
NEXT_PUBLIC_BRAND=atelier
# Studio master accounts (can see every account, send client links, read workshop sheets):
# comma-separated names they sign in with, e.g. Carl
STUDIO_ADMINS=
# Accounts with a higher daily AI limit (comma-separated sign-in names), and that limit
AI_POWER_USERS=
AI_POWER_LIMIT=300
